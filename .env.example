# --- Anthropic ---
ANTHROPIC_API_KEY=
SPRINTBATON_OPUS_MODEL=claude-opus-4-8
SPRINTBATON_SONNET_MODEL=claude-sonnet-5
SPRINTBATON_ROUTER_MODEL=claude-haiku-4-5

# --- Todolist provider ---
# The provider itself is per-repository (Repository.todolistProvider); this token
# is the deployment-wide fallback when no Credential row answers (onboarding spec §4)
TODOLIST_API_TOKEN=
# The provider-side user/collaborator id that represents the agent
SPRINTBATON_AGENT_USER_ID=sprintbaton-agent

# --- GitHub ---
# Deployment-wide fallback token (a repo-level or user-default Credential wins)
GITHUB_TOKEN=

# --- Polling ---
POLL_INTERVAL_SECONDS=60

# --- MongoDB ---
MONGO_BASE_URI=mongodb://localhost:27017
MONGO_DATABASE=sprintbaton

# --- PostgreSQL (SPRINTBATON_PERSISTENCE_BACKEND=postgres) ---
# A libpq DSN; TLS etc. ride it as libpq parameters (sslmode=verify-full).
POSTGRES_DSN=
POSTGRES_SCHEMA=
POSTGRES_POOL_MAX_SIZE=10

# --- Redis ---
REDIS_URI=redis://localhost:6379/0

# --- S3 blob driver (AWS S3, MinIO, any S3-compatible store) ---
# Empty endpoint = AWS's default for the region; empty keys = the default
# AWS credential chain (env, shared config, IRSA/web identity, instance role).
S3_ENDPOINT=http://localhost:9000
S3_REGION=
S3_BUCKET=sprintbaton
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Off by default: a missing bucket fails startup. MinIO dev setups turn it on.
S3_CREATE_BUCKET=true
# path | virtual | auto (MinIO usually wants path)
S3_ADDRESSING_STYLE=path

# --- Google Cloud Storage (SPRINTBATON_BLOB_BACKEND=gcs) ---
# Application-default credentials (workload identity on GKE); no key setting.
# The bucket must already exist.
GCS_BUCKET=
GCS_PROJECT=

# --- Azure Blob Storage (SPRINTBATON_BLOB_BACKEND=azure) ---
# DefaultAzureCredential (managed/workload identity, env) unless a connection
# string is set (non-identity installs, Azurite). The container must exist.
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER=
AZURE_STORAGE_CONNECTION_STRING=
# Optional: overrides https://<account>.blob.core.windows.net
AZURE_ACCOUNT_URL=

# --- Credential vault (hosted mode) ---
# Wraps per-credential data keys with a master key held outside the database.
# "local" (default) = generated key file; "hashicorp" = HashiCorp Vault KV.
SPRINTBATON_VAULT_BACKEND=local
# local backend:
SPRINTBATON_MASTER_KEY_PATH=~/.sprintbaton/master.key
# hashicorp backend (mount VAULT_TOKEN as a k8s secret):
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=false
SPRINTBATON_VAULT_KEY_PATH=secrets/sprintbaton/masterKey
SPRINTBATON_VAULT_KEY_FIELD=value
SPRINTBATON_VAULT_KV_VERSION=2

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sprintbaton
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
LOG_LEVEL=info

# --- Escalation tunables ---
ESCALATION_REGION_EDIT_LIMIT=3
ESCALATION_FIX_ATTEMPTS=2
ESCALATION_NOPROGRESS_WINDOW=4
ESCALATION_MAX_CLARIFY_ROUNDS=3
ESCALATION_GLOBAL_TOKEN_CAP=2000000
ESCALATION_TIER_TOKEN_BUDGET=400000
ESCALATION_TIER_WALL_CLOCK_SECONDS=1800
